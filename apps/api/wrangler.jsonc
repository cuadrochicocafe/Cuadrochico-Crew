// Configuración del Worker de pedidos. Los secretos NO van aquí: ver .dev.vars.example y README.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cuadrochico-pedidos",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // La app web compilada (pnpm build). /api/* siempre llega al Worker; lo demás es la SPA.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cuadrochico-pedidos",
      // Reemplaza con el id que da `wrangler d1 create cuadrochico-pedidos`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Cada 15 minutos expira los pedidos sin pagar que ya vencieron.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
